generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("EMPLOYEE")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())

  sales     Sale[]
  expenses  Expense[]
  returns   Return[]
  auditLogs AuditLog[]

  @@map("users")
}

model BusinessLocation {
  id      String  @id @default(uuid())
  name    String // e.g. FRANCIS AMOAKO VENTURES (BL0001)
  code    String  @unique // BL0001
  address String?
  phone   String?

  sales Sale[]

  @@map("business_locations")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Unit {
  id        String    @id @default(uuid())
  name      String    @unique // e.g. Pieces, Sheets, Meters, Bundles
  shortName String // e.g. Pc(s), Sheet, m, Bdl
  products  Product[]

  @@map("units")
}

model CustomerGroup {
  id        String     @id @default(uuid())
  name      String // Retail, Wholesale, Contractor
  discount  Float      @default(0)
  customers Customer[]

  @@map("customer_groups")
}

model Customer {
  id          String         @id @default(uuid())
  name        String
  phone       String?
  email       String?
  groupId     String?        @map("group_id_fk")
  group       CustomerGroup? @relation(fields: [groupId], references: [id])
  creditLimit Float          @default(0) @map("credit_limit")
  sales       Sale[]

  @@index([groupId])
  @@map("customers")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  companyName String?  @map("company_name")
  phone       String?
  email       String?
  createdAt   DateTime @default(now())

  @@map("suppliers")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  sku           String    @unique
  barcode       String?   @unique
  categoryId    String?   @map("category_id_fk")
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?   @map("brand_id_fk")
  brand         Brand?    @relation(fields: [brandId], references: [id])
  unitId        String?   @map("unit_id_fk")
  unit          Unit?     @relation(fields: [unitId], references: [id])
  pricePerUnit  Float     @map("price_per_unit")
  costPrice     Float     @default(0) @map("cost_price")
  stockQuantity Int       @default(0) @map("stock_quantity")
  minStockAlert Int       @default(5) @map("min_stock_alert")
  imageUrl      String?   @map("image_url")
  isFeatured    Boolean   @default(false) @map("is_featured")
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? @map("deleted_at")

  metadata  ProductMetadata[]
  saleItems SaleItem[]

  @@index([deletedAt])
  @@index([deletedAt, name])
  @@index([categoryId])
  @@map("products")
}

model ProductMetadata {
  id        String  @id @default(uuid())
  productId String  @map("product_id_fk")
  key       String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_metadata")
}

model Sale {
  id             String            @id @default(uuid())
  invoiceNo      String            @unique @map("invoice_no")
  locationId     String?           @map("location_id_fk")
  location       BusinessLocation? @relation(fields: [locationId], references: [id])
  cashierId      String            @map("cashier_id_fk")
  cashier        User              @relation(fields: [cashierId], references: [id])
  customerId     String?           @map("customer_id_fk")
  customer       Customer?         @relation(fields: [customerId], references: [id])
  status         String            @default("COMPLETED")
  paymentMethod  String            @default("CASH") @map("payment_method")
  totalAmount    Float             @map("total_amount")
  discountAmount Float             @default(0) @map("discount_amount")
  taxAmount      Float             @default(0) @map("tax_amount")
  paidAmount     Float             @default(0) @map("paid_amount")
  changeAmount   Float             @default(0) @map("change_amount")
  note           String?
  createdAt      DateTime          @default(now())

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@map("sales")
  @@index([status, createdAt])
  @@index([cashierId])
  @@index([customerId])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String  @map("sale_id_fk")
  productId   String  @map("product_id_fk")
  quantity    Int
  priceAtSale Float   @map("price_at_sale")
  costAtSale  Float   @default(0) @map("cost_at_sale")

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id_fk")
  method    String
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Float
  description String?
  userId      String?  @map("user_id_fk")
  user        User?    @relation(fields: [userId], references: [id])
  date        DateTime @default(now())

  @@map("expenses")
  @@index([date])
  @@index([category])
}

model VariationTemplate {
  id        String            @id @default(uuid())
  name      String            @unique
  options   VariationOption[]

  @@map("variation_templates")
}

model VariationOption {
  id         String            @id @default(uuid())
  templateId String            @map("template_id_fk")
  value      String

  template   VariationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("variation_options")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model Return {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id_fk")
  userId    String   @map("user_id_fk")
  amount    Float
  reason    String?
  createdAt DateTime @default(now())

  sale      Sale     @relation(fields: [saleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  items     ReturnItem[]

  @@index([saleId])
  @@index([userId])
  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(uuid())
  returnId    String   @map("return_id_fk")
  saleItemId  String   @map("sale_item_id_fk")
  quantity    Int
  condition   String   @default("GOOD") // GOOD, DAMAGED

  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
  @@map("return_items")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id_fk")
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
